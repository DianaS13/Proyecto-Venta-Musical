@model IEnumerable<PIV_PROYECTO_Final.Models.ModuloCancione>

@{
    ViewData["Title"] = "";
}
<h1>@ViewData["Title"]</h1>

<div class="container separador-container">
</div>
<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.NombreCancion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecioCancion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CodigoGeneroNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreCancion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PrecioCancion)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CodigoGeneroNavigation.CodigoGenero)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.CodigoCancion">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.CodigoCancion">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CodigoCancion">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
