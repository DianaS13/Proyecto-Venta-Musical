@model IEnumerable<PIV_PROYECTO_Final.Models.ModuloCancione>
<br />
<br />
<br />
<br />

@{
	ViewData["Title"] = "CATÁLOGO";
}

<br />
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="~/style.css">
	<title>Catálogo</title>
</head>

<body class="body-catalogos">
	<section class="container mb-4">
		<div class="preloader d-flex align-items-center justify-content-center">
			<div class="lds-ellipsis">
				<div></div>
				<div></div>
				<div></div>
				<div></div>
			</div>
		</div>
	</section>

	<!-- Sección del buscador -->
	<section class="container">
		<div class="row">
			<div class="col-md-6">
				<input type="text" id="inputId" class="form-control" placeholder="A-Z" pattern="\d{1}-\d{4}-\d{4}">
			</div>
			<div class="col-md-6">
				<input type="text" id="inputGenero" class="form-control" placeholder="Género">
			</div>
		</div>
		<div class="row mt-2">
			<div class="col-md-12">
				<button id="btnBuscar" class="btn btn-sm btn-primary mr-2" type="button">Buscar</button>
				<button id="btnRestablecer" class="btn btn-sm btn-info" type="button">Restablecer</button>
			</div>
		</div>
	</section>

	<!-- Sección del catálogo -->
	<br />
	<section class="oneMusic-catalogos has-fluid bg-gray section-padding-100">
		<div class="container-fluid">
			<div class="row">
				<div class="col-12">
					<div class="section-heading style-2">
						<h2>CATALOGO MÚSICAL</h2>
					</div>
				</div>
			</div>

			<div class="row">
				<div class="col-12">
					<div class="row" id="cancionesContainer">
						@foreach (var item in Model)
						{
							<div class="col-16 col-sm-6 col-md-4 col-lg-2 single-album-area" style="display: block;">
								<div style="text-align: center;" class="album-info">
									<a href="#" onclick="mostrarDetalles('@Html.DisplayFor(modelItem => item.NombreCancion)','@Html.DisplayFor(modelItem => item.CodigoGenero)' ,'@Html.DisplayFor(modelItem => item.PrecioCancion)')">
										<h5>@Html.DisplayFor(modelItem => item.NombreCancion)</h5>
									</a>
									<p class="genero">@Html.DisplayFor(modelItem => item.CodigoGenero)</p>
									<p>₡ @string.Format("{0:n0}", item.PrecioCancion)</p>
									<div style="text-align: center;">
										<a href="@Url.Action("Comprar", new { id = item.CodigoCancion })">
											<button type="button" class="btn btn-sm btn-primary">Comprar</button>
										</a>
										@if (User.IsInRole("Administrador"))
										{
											<a href="@Url.Action("Edit", new { id = item.CodigoCancion })" class="btn btn-sm btn-warning">Editar</a>
										}
									</div>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Modal para mostrar detalles de la canción -->
	<div class="modal fade" id="cancionModal" tabindex="-1" role="dialog" aria-labelledby="cancionModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" role="document">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="cancionModalLabel">Detalles de la canción</h5>
					<button type="button" class="close" data-dismiss="modal" aria-label="Close">
						<span aria-hidden="true">&times;</span>
					</button>
				</div>
				<div class="modal-body" id="cancionModalBody">
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
				</div>
			</div>
		</div>
	</div>
	<script>
		function mostrarDetalles(titulo, CodigoGenero, precio) {

			var modalContent = `
															<h5>${titulo}</h5>
															<p>Genero: ${CodigoGenero}</p>
															<p>Precio: ₡ ${precio}</p>`;

			document.getElementById('cancionModalBody').innerHTML = modalContent;

			$('#cancionModal').modal('show');
		}
		document.addEventListener('DOMContentLoaded', function () {
			const btnBuscar = document.getElementById('btnBuscar');
			const btnRestablecer = document.getElementById('btnRestablecer');
			const inputId = document.getElementById('inputId');
			const inputGenero = document.getElementById('inputGenero');

			btnBuscar.addEventListener('click', function () {
				const idBusqueda = inputId.value.trim().toLowerCase();
				const generoBusqueda = inputGenero.value.trim().toLowerCase(); 
				const rows = document.querySelectorAll('.single-album-area');

				if (idBusqueda === "" && generoBusqueda === "") {
					alert("Por favor ingresa un título o un género para buscar.");
					return;
				}

				rows.forEach(function (row) {
					const titulo = row.querySelector('h5').textContent.trim().toLowerCase();
					const genero = row.querySelector('.genero').textContent.trim().toLowerCase(); 

					if ((idBusqueda === "" || titulo.includes(idBusqueda)) && (generoBusqueda === "" || genero.includes(generoBusqueda))) {
						row.style.display = 'block';
					} else {
						row.style.display = 'none';
					}
				});
			});

			btnRestablecer.addEventListener('click', function () {
				const rows = document.querySelectorAll('.single-album-area');

				rows.forEach(function (row) {
					row.style.display = 'block';
				});

				inputId.value = '';
				inputGenero.value = '';
			});
		});
	</script>
</body>
</html>
