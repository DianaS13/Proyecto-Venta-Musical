@model PIV_PROYECTO_Final.Models.ModuloCancione

<br />
<br />
<br />
<br />
<br />
<br />

@{
    ViewData["Title"] = "Edit";
}

<style>
    body {
        background-color: #f8f9fa;
        padding: 50px;
    }

    h1 {
        text-align: center;
        margin-bottom: 30px;
    }

    form {
        max-width: 500px;
        margin: 0 auto;
        padding: 30px;
        border-radius: 10px;
        box-shadow: 0px 0px 15px 0px rgba(0,0,0,0.1);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 5px;
    }

    input[type="submit"] {
        width: 100%;
        border-radius: 5px;
        margin-bottom: 10px;
    }

    a.btn-secondary {
        width: 100%;
        border-radius: 5px;
    }
</style>
<h1>Editar las Canciones</h1>

<hr />
<div class="row text-center">
    <div class="col">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CodigoCancion" />
            <div class="form-group">
                <label asp-for="CodigoCancion" class="control-label">Codigo de la Cancion</label>
                <input asp-for="CodigoCancion" class="form-control" readonly />
                <span asp-validation-for="CodigoCancion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NombreCancion" class="control-label">Nombre de la Cancion</label>
                <input asp-for="NombreCancion" class="form-control" />
                <span asp-validation-for="NombreCancion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecioCancion" class="control-label">Precio</label>
                <input asp-for="PrecioCancion" class="form-control" />
                <span asp-validation-for="PrecioCancion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CodigoGenero" class="control-label">Descripcion del Genero</label>
                <select asp-for="CodigoGenero" class="form-control" asp-items="ViewBag.CodigoGenero"></select>
                <span asp-validation-for="CodigoGenero" class="text-danger"></span>
            </div>
            <div class="form-center">
                <input type="submit" value="Guardar" class="btn btn-sm btn-primary" />
                <a class="btn btn-sm btn-info" asp-action="Index">Volver</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<!-- Quita los decimales del precio -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var precioInput = document.getElementById("PrecioCancion");

        var valor = precioInput.value;

        var valorNumerico = parseFloat(valor.replace(',', '.'));
        var valorAntesComa = Math.floor(valorNumerico);

        precioInput.value = valorAntesComa;

        getId();


    });

    function getId() {
        var idInput = document.getElementById("idc");
        console.log(idInput.value);
        ID_CANCION.value = idInput.value;
    }
</script>