@model PIV_PROYECTO_Final.Models.ModuloCancione

@{
    ViewData["Title"] = "Comprar";
}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/comprar-style.css">
</head>

<br/>
<br/>
<br />
<br />
<br />

<body>
        <h1>Comprar</h1>
        <div class="form">
            <div class="form-body">
                <form asp-action="Comprar">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="NombreCancion" class="control-label">Canción</label>
                        <input asp-for="NombreCancion" class="form-control" readonly />
                        <span asp-validation-for="NombreCancion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PrecioCancion" class="control-label">Precio</label>
                        <input id="precioInput" asp-for="PrecioCancion" class="form-control" readonly />
                        <span asp-validation-for="PrecioCancion" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CodigoGenero" class="control-label">Género</label>
                        <input asp-for="CodigoGenero" class="form-control" readonly />
                        <span asp-validation-for="CodigoGenero" class="text-danger"></span>
                    </div>
                    <input type="hidden" id="ID_USUARIO" name="ID_USUARIO" value="@User.Identity?.Name" />
                    <input type="hidden" id="ID_CANCION" name="ID_CANCION" />
                    <input type="hidden" id="idc" asp-for="CodigoCancion" />
                    <div class="form-group">
                        <input type="submit" value="Comprar" class="btn btn-primary btn-block" />
                        <a class="btn btn-warning btn-block mt-3" asp-action="Index">Volver</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
<br />
<br />
<br />
<br />


<!-- Quita los decimales del precio -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var precioInput = document.getElementById("precioInput");

        var valor = precioInput.value;

        var valorNumerico = parseFloat(valor.replace(',', '.'));
        var valorAntesComa = Math.floor(valorNumerico);

        precioInput.value = valorAntesComa;

        getId();


    });

    function getId() {
        var idInput = document.getElementById("idc");
        console.log(idInput.value);
        ID_CANCION.value = idInput.value;
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
