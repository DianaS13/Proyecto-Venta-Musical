@using Microsoft.AspNetCore.Identity
@model IdentityRole
<br />
<br />
<br />
<br />
<br />
<br />
@{
	ViewData["Title"] = "Datos de Roles";
}

<h1>DATOS DE ROLES</h1>
<br />
<section class="container">
	<div>
		<hr />
		<dl class="row">
			<dt class="col-sm-2">
				Nombre
			</dt>
			<dd class="col-sm-10">
				@Html.DisplayFor(model => model.Name)
			</dd>
		</dl>
	</div>
	<div>
		<a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
		<a href="@Url.Action("Index")" class="btn btn-secondary">Volver a la lista</a>
	</div>
	<style>

		.container {
			display: auto;
			justify-content: center;
			max-width: 1800px;
			width: 100%;
			padding: 0 10px;
		}

	</style>
