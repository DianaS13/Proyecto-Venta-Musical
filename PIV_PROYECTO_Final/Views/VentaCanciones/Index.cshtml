@model IEnumerable<PIV_PROYECTO_Final.Models.VentaCancione>

@{
	ViewData["Title"] = "LISTADO DE COMPRAS";
}

<!DOCTYPE html>
<html>
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="~/style.css">

	<style>
		body {
			margin: 80px;
			padding: 0;
			background-color: transparent;
		}

		.container {
			border: 2px solid #ccc;
			border-radius: 10px;
			padding: 20px;
			margin: 50px auto;
			max-width: 800px;
			background-color: rgba(255, 255, 255, 0.8);
		}

			.container h1 {
				text-align: center;
			}

	</style>

</head>
<body class="body-compras">
	<h1>LISTADO DE COMPRAS</h1>
	<table class="table table-striped table-bordered">
		<thead class="thead-dark">
			<tr>
					<th>
						@Html.DisplayNameFor(model => model.NumeroFactura).Replace("NumeroFactura", "Factura")
					</th>
				<th>
					@Html.DisplayNameFor(model => model.Subtotal)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.Total)
				</th>
				<th>
					@Html.DisplayNameFor(model => model.FechaCompra).Replace("FechaCompra", "Fecha de la Compra")
				</th>
				@if (User.IsInRole("Administrador"))
				{
					<th>
						@Html.DisplayNameFor(model => model.UsuariosIdentificacion).Replace("UsuariosIdentificacion", "Cedula")
					</th>
				}
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr>
				
						<td>
							@Html.DisplayFor(modelItem => item.NumeroFactura)
						</td>
					
					<td>

						₡ @String.Format("{0:n0}", item.Subtotal)
					</td>
					<td>

						₡ @String.Format("{0:n0}", item.Total)
					</td>
					<td>
						@Html.DisplayFor(modelItem => item.FechaCompra)
					</td>
					@if (User.IsInRole("Administrador"))
					{
						<td>
							@Html.DisplayFor(modelItem => item.UsuariosIdentificacion)
						</td>
					}
					<td>

						<button type="button" class="btn btn-sm btn-info" data-toggle="modal" data-target="#myModal_@item.NumeroFactura">
							Detalles de la Compra
						</button>


						<div class="modal fade" id="myModal_@item.NumeroFactura">
							<div class="modal-dialog">
								<div class="modal-content">

									<div class="modal-header">
										<h4 class="modal-title">Detalles de la compra</h4>
										<button type="button" class="close" data-dismiss="modal">&times;</button>
									</div>
									<div class="modal-body">

										<dl class="row">
											<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subtotal)</dt>
											<dd class="col-sm-10">₡ @String.Format("{0:n0}", item.Subtotal)</dd>
											<dt class="col-sm-2">@Html.DisplayNameFor(model => model.Total)</dt>
											<dd class="col-sm-10">₡ @String.Format("{0:n0}", item.Total)</dd>
											<dt class="col-sm-2">@Html.DisplayNameFor(model => model.FechaCompra)</dt>
											<dd class="col-sm-10">@Html.DisplayFor(model => item.FechaCompra)</dd>
											@if (User.IsInRole("Administrador"))
											{
												<dt class="col-sm-2">Cedula</dt>
												<dd class="col-sm-10">@Html.DisplayFor(model => item.UsuariosIdentificacion)</dd>
											}
										</dl>
									</div>

									<div class="modal-footer">
										<button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
									</div>
								</div>
							</div>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>

	<button type="button" class="btn btn-primary" onclick="window.location.href = '@Url.Action("Index", "CANCIONES_USUARIO")'">Volver al carrito</button>
	<br />
	<br />
	<br />
	<br />
    <br />
</body>
</html>
