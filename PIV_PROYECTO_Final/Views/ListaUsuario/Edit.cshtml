@model PIV_PROYECTO_Final.Models.ListaUsuario.EditarDato

<br />
<br />
<br />
<br />
<br />
<br />
<h1 style="text-align: center;">Actualizar Usuario</h1>

<hr />
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit" class="card p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="cedula" />

                <div class="form-group">
                    <label asp-for="cedula" class="control-label">Cédula</label>
                    <input asp-for="cedula" class="form-control" readonly oninput="formatoCedula(this)" />
                    <span asp-validation-for="cedula" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Telefono" class="control-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" oninput="formatoTelefono(this)" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NombreCompleto" class="control-label">Nombre Completo</label>
                    <input asp-for="NombreCompleto" class="form-control" />
                    <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Genero" class="control-label">Género</label>
                    <select asp-for="Genero" class="form-control" id="generoSeleccion" onchange="limpiarErroresGenero()">
                        <option value="">Seleccione su género</option>
                        <option value="Masculino">Masculino</option>
                        <option value="Femenino">Femenino</option>
                    </select>
                    <span asp-validation-for="Genero" class="text-danger" id="errorGenero"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TipoTarjeta" class="control-label">Tipo de Tarjeta</label>
                    <input asp-for="TipoTarjeta" class="form-control" id="tipoTarjetaInput" readonly />
                    <span asp-validation-for="TipoTarjeta" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NumeroTarjeta" class="control-label">Número de Tarjeta</label>
                    <input asp-for="NumeroTarjeta" class="form-control" oninput="formatoYMostrarTipoTarjeta(this)" />
                    <span asp-validation-for="NumeroTarjeta" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Correo" class="control-label">Correo Electrónico</label>
                    <input asp-for="Correo" class="form-control" id="correoInput" />
                    <span asp-validation-for="Correo" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <input asp-for="Username" class="form-control d-none" id="usernameInput" />
                    <input asp-for="NormalizedName" class="form-control d-none" id="normalizedNameInput" />
                </div>

                <div class="form-group">
                    <label asp-for="IdROl" class="control-label">Rol del Usuario</label>
                    <select asp-for="IdROl" class="form-control" id="rolSeleccion" onchange="limpiarErroresRol()">
                        <option value="Usuario">Usuario</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <span asp-validation-for="IdROl" class="text-danger" id="errorRol"></span>
                </div>

                <div class="mb-3">
                    <input type="submit" value="Guardar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Enlaces a jQuery y Bootstrap JavaScript -->
<script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    //Este script copia el correo en el username y normalized
    document.getElementById('correoInput').addEventListener('input', function () {
        var correoValue = this.value;
        document.getElementById('usernameInput').value = correoValue;
        document.getElementById('normalizedNameInput').value = correoValue.toUpperCase();
    });

    //Muestra el genero actual y selecciona
    var generoActual = "@Model.Genero";
    var selectGenero = document.getElementById("generoSeleccion");
    for (var i = 0; i < selectGenero.options.length; i++) {
        if (selectGenero.options[i].value === generoActual) {
            selectGenero.options[i].setAttribute("selected", "selected");
            break;
        }
    }

    //Muestra el rol actual y selecciona
    var rolActual = "@Model.IdROl";
    var selectRol = document.getElementById("rolSeleccion");
    for (var i = 0; i < selectRol.options.length; i++) {
        if (selectRol.options[i].value === rolActual) {
            selectRol.options[i].setAttribute("selected", "selected");
            break;
        }
    }

    //Formato la cedula
    function formatoCedula(input) {
        var cedulaSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
        if (cedulaSinFormato.length > 9) {
            cedulaSinFormato = cedulaSinFormato.substr(0, 9);
        }
        var cedulaFormateada = '';
        for (var i = 0; i < cedulaSinFormato.length; i++) {
            if (i === 1 || i === 5) {
                cedulaFormateada += '-';
            }
            cedulaFormateada += cedulaSinFormato[i];
        }
        input.value = cedulaFormateada;
    }

    //Mostrar, limitar, formato y el tipo en la tarjeta y tipo de tarjeta
    function formatoYMostrarTipoTarjeta(input) {
        var numeroSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');

        // Limitar a 16
        if (numeroSinFormato.length > 16) {
            numeroSinFormato = numeroSinFormato.substr(0, 16);
        }

        // Aplicar el formato
        var numeroFormateado = '';
        for (var i = 0; i < numeroSinFormato.length; i++) {
            if (i > 0 && i % 4 == 0) {
                numeroFormateado += '-';
            }
            numeroFormateado += numeroSinFormato[i];
        }
        input.value = numeroFormateado;

        //Saber el tipo
        var tipo;
        if (/^4/.test(numeroSinFormato)) {
            tipo = "Visa";
        } else if (/^5/.test(numeroSinFormato)) {
            tipo = "Mastercard";
        } else if (/^3[47]/.test(numeroSinFormato)) {
            tipo = "American Express";
        } else {
            tipo = "Desconocida";
        }

        document.getElementById("tipoTarjetaInput").value = tipo;
    }

    //Limpia la pantalla de los errores al momento que se escribe
    function limpiarErrores(input) {
        var spanError = input.nextElementSibling;
        if (spanError) {
            spanError.textContent = '';
        }
    }
    var inputs = document.querySelectorAll('input');
    inputs.forEach(function (input) {
        input.addEventListener('input', function () {
            limpiarErrores(input);
        });
    });

    //Limpia la pantalla del error del tipo de tarjeta al momento que se escribe en el numero tarjeta
    function limpiarErrorTipoTarjeta() {
        var spanError = document.querySelector('#tipoTarjetaInput + .text-danger');
        if (spanError) {
            spanError.textContent = '';
        }
    }
    var numeroTarjetaInput = document.getElementById('NumeroTarjeta');
    if (numeroTarjetaInput) {
        numeroTarjetaInput.addEventListener('input', function () {
            limpiarErrorTipoTarjeta();
        });
    }

    //Limpia el genero del error
    function limpiarErroresGenero() {
        var spanError = document.getElementById('errorGenero');
        if (spanError) {
            spanError.textContent = '';
        }
    }

    //Formato al telefono
    function formatoTelefono(input) {
        var telefonoSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
        if (telefonoSinFormato.length > 8) {
            telefonoSinFormato = telefonoSinFormato.substr(0, 8);
        }
        var telefonoFormateado = '';
        for (var i = 0; i < telefonoSinFormato.length; i++) {
            if (i === 4) {
                telefonoFormateado += '-';
            }
            telefonoFormateado += telefonoSinFormato[i];
        }
        input.value = telefonoFormateado;
    }
</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}