@model PIV_PROYECTO_Final.Models.ListaUsuario.Contrasena
<!-- Agregar enlaces a Bootstrap CSS -->
<br />
<br />
<br />
<br />
<br />
<h1>Cambiar Contraseña</h1>

<form asp-action="CambiarContrasena" method="post">
    <div asp-validation-summary="None" class="text-danger"></div> @*Si se utiliza la abrebiacion en el None, el ALl, lo que realiza es que muestra todos los errores que tiene*@

    <input type="hidden" asp-for="Cedula" />
    <div class="form-floating">
        <input asp-for="Cedula" class="form-control" readonly />
        <label asp-for="Cedula" class="form-label"></label>
    </div>

    <div class="form-group">
        <label asp-for="NuevaContrasena">Nueva Contraseña:</label>
        <input asp-for="NuevaContrasena" class="form-control" />
        <span asp-validation-for="NuevaContrasena" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
</form>