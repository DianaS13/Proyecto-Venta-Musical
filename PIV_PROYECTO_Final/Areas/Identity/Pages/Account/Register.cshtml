@page
@model RegisterModel
@{
	ViewData["Title"] = "";
}

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<link rel="stylesheet" href="cuenta-styles.css">
	<title>@ViewData["Title"]</title>>
</head>
<body>

	<h1 class="text-center">@ViewData["Title"]</h1>
	<main role="main" class="pb-3" style="margin-top: 80px;"></main>

	<section class="container">
		<!-- Preloader -->
		<div class="preloader d-flex align-items-center justify-content-center">
			<div class="lds-ellipsis">
				<div></div>
				<div></div>
				<div></div>
				<div></div>
			</div>
		</div>
		<!-- Carousel -->
		<div id="carouselregistro" class="carousel slide" data-ride="carousel" data-interval="5000">
			<ol class="carousel-indicators">
				<li data-target="#carouselregistro" data-slide-to="0" class="active"></li>
				<li data-target="#carouselregistro" data-slide-to="1"></li>
				<li data-target="#carouselregistro" data-slide-to="2"></li>
			</ol>
			<div class="carousel-inner">
				<div class="carousel-item active">
					<img class="d-block w-100" src="~/img/bg-img/bg9.jpg" alt="Primera">
				</div>
				<div class="carousel-item">
					<img class="d-block w-100" src="~/img/bg-img/bg7.jpg" alt="Segunda">
				</div>
				<div class="carousel-item">
					<img class="d-block w-100" src="~/img/bg-img/bg8.jpg" alt="Tercera">
				</div>
				<div class="carousel-item">
					<img class="d-block w-100" src="~/img/bg-img/bg10.jpg" alt="Cuarta">
				</div>
			</div>
			<a class="carousel-control-prev" href="#carouselregistro" role="button" data-slide="prev">
				<span class="sr-only">Previous</span>
			</a>
			<a class="carousel-control-next" href="#carouselregistro" role="button" data-slide="next">
				<span class="sr-only">Next</span>
			</a>
		</div>
	</section>
	<div class="registercontainer">
		<div class="row justify-content-center">
			<div class="col-md-16 registerform">
				<form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
					<h2 class="mb-4 text-center">Creación de Nuevo Usuario</h2>
					<div asp-validation-summary="ModelOnly" class="text-danger"></div>

					<div class="form-group">
						<label asp-for="Input.Email" class="control-label">Email</label>
						<input asp-for="Input.Email" class="registerfield" />
						<span asp-validation-for="Input.Email" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.Password" class="control-label">Contraseña</label>
						<input asp-for="Input.Password" class="registerfield" type="password" />
						<span asp-validation-for="Input.Password" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.ConfirmPassword" class="control-label">Confirmar contraseña</label>
						<input asp-for="Input.ConfirmPassword" class="registerfield" type="password" />
						<span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.NombreCompleto" class="control-label">Nombre Completo</label>
						<input asp-for="Input.NombreCompleto" class="registerfield" />
						<span asp-validation-for="Input.NombreCompleto" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.cedula" class="control-label">Identificación</label>
						<input asp-for="Input.cedula" class="registerfield" oninput="formatoCedula(this)" />
						<span asp-validation-for="Input.cedula" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.Genero" class="control-label">Género</label>
						<select asp-for="Input.Genero" class="registerfield">
							<option value="">Seleccione su género</option>
							<option value="Masculino">Masculino</option>
							<option value="Femenino">Femenino</option>
						</select>
						<span asp-validation-for="Input.Genero" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.TipoTarjeta" class="control-label">Tarjeta (Campo automático)</label>
						<input asp-for="Input.TipoTarjeta" class="registerfield" id="tipoTarjetaInput" readonly />
						<span asp-validation-for="Input.TipoTarjeta" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.NumeroTarjeta" class="control-label">Número de tarjeta de crédito</label>
						<input asp-for="Input.NumeroTarjeta" class="registerfield" oninput="formatoYMostrarTipoTarjeta(this)" />
						<span asp-validation-for="Input.NumeroTarjeta" class="text-danger"></span>
					</div>

					<div class="form-group">
						<label asp-for="Input.Telefono" class="control-label">Número de teléfono</label>
						<input asp-for="Input.Telefono" class="registerfield" oninput="formatoTelefono(this)" />
						<span asp-validation-for="Input.Telefono" class="text-danger"></span>
					</div>

					<button id="registerSubmit" type="submit" class="btn btn-primary btn-block mt-3">Registro</button>
				</form>
			</div>
		</div>
	</div>

	<script>
		@*Mostrar, limitar, formato y el tipo en la tarjeta y tipo de tarjeta*@
			function formatoYMostrarTipoTarjeta(input) {
				var numeroSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');

				// Limitar a 16
				if (numeroSinFormato.length > 16) {
					numeroSinFormato = numeroSinFormato.substr(0, 16);
				}

				// Aplicar el formato
				var numeroFormateado = '';
				for (var i = 0; i < numeroSinFormato.length; i++) {
					if (i > 0 && i % 4 == 0) {
						numeroFormateado += '-';
					}
					numeroFormateado += numeroSinFormato[i];
				}
				input.value = numeroFormateado;

				//Saber el tipo
				var tipo;
				if (/^4/.test(numeroSinFormato)) {
					tipo = "Visa";
				} else if (/^5/.test(numeroSinFormato)) {
					tipo = "Mastercard";
				} else if (/^3[47]/.test(numeroSinFormato)) {
					tipo = "American Express";
				} else {
					tipo = "Desconocida";
				}

				document.getElementById("tipoTarjetaInput").value = tipo;
			}


		@*Formato la cedula*@
			function formatoCedula(input) {
				var cedulaSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
				if (cedulaSinFormato.length > 9) {
					cedulaSinFormato = cedulaSinFormato.substr(0, 9);
				}
				var cedulaFormateada = '';
				for (var i = 0; i < cedulaSinFormato.length; i++) {
					if (i === 1 || i === 5) {
						cedulaFormateada += '-';
					}
					cedulaFormateada += cedulaSinFormato[i];
				}
				input.value = cedulaFormateada;
			}
		@*Formato al telefono*@
			function formatoTelefono(input) {
				var telefonoSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
				if (telefonoSinFormato.length > 8) {
					telefonoSinFormato = telefonoSinFormato.substr(0, 8);
				}
				var telefonoFormateado = '';
				for (var i = 0; i < telefonoSinFormato.length; i++) {
					if (i === 4) {
						telefonoFormateado += '-';
					}
					telefonoFormateado += telefonoSinFormato[i];
				}
				input.value = telefonoFormateado;
			}

		@*Limpia la pantalla de los errores al momento que se escribe*@
			function limpiarErrores(input) {
				var spanError = input.nextElementSibling;
				if (spanError) {
					spanError.textContent = '';
				}
			}
		var inputs = document.querySelectorAll('input');
		inputs.forEach(function (input) {
			input.addEventListener('input', function () {
				limpiarErrores(input);
			});
		});

		@*Limpia la pantalla del error del tipo de tarjeta al momento que se escribe en el numero tarjeta*@
			function limpiarErrorTipoTarjeta() {
				var spanError = document.querySelector('[data-valmsg-for="Input.TipoTarjeta"]');
				if (spanError) {
					spanError.textContent = '';
				}
			}

		var numeroTarjetaInput = document.getElementById('Input_NumeroTarjeta');
		if (numeroTarjetaInput) {
			numeroTarjetaInput.addEventListener('input', function () {
				limpiarErrorTipoTarjeta();
			});
		}
		//Limpia el error en el genero
		function limpiarErroresGenero() {
			var spanError = document.querySelector('[data-valmsg-for="Input.Genero"]');
			if (spanError) {
				spanError.textContent = '';
			}
		}

	</script>
	</div>
	</div>

	<!-- Scripts -->
	<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

</body>
</html>
