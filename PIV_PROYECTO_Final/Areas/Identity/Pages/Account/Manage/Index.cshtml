@page
@model IndexModel

@{
    ViewData["Title"] = "Cuenta";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<body class="body-update">
<h3>@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-6">
        <form id="profile-form" method="post">


            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Input.cedula" class="control-label">Cédula</label>
                <input asp-for="Input.cedula" class="form-control" readonly oninput="formatoCedula(this)" />
                <span asp-validation-for="Input.cedula" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Correo" class="control-label">Correo Electrónico</label>
                <input asp-for="Input.Correo" class="form-control" id="correoInput" />
                <span asp-validation-for="Input.Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input asp-for="Input.Username" class="form-control d-none" id="usernameInput" />
                <input asp-for="Input.NormalizedName" class="form-control d-none" id="normalizedNameInput" />
            </div>

            <div class="form-group">
                <label asp-for="Input.NombreCompleto" class="control-label">Nombre Completo</label>
                <input asp-for="Input.NombreCompleto" class="form-control" />
                <span asp-validation-for="Input.NombreCompleto" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Genero" class="control-label">Género</label>
                <select asp-for="Input.Genero" class="form-control" id="generoSeleccion" onchange="limpiarErroresGenero()">
                    <option value="">Seleccione su género</option>
                    <option value="Masculino">Masculino</option>
                    <option value="Femenino">Femenino</option>
                </select>
                <span asp-validation-for="Input.Genero" class="text-danger" id="errorGenero"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.TipoTarjeta" class="control-label">Tipo de Tarjeta</label>
                <input asp-for="Input.TipoTarjeta" class="form-control" id="tipoTarjetaInput" readonly />
                <span asp-validation-for="Input.TipoTarjeta" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.NumeroTarjeta" class="control-label">Número de Tarjeta</label>
                <input asp-for="Input.NumeroTarjeta" class="form-control" oninput="formatoYMostrarTipoTarjeta(this)" />
                <span asp-validation-for="Input.NumeroTarjeta" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Input.PhoneNumber" class="control-label">Teléfono</label>
                <input asp-for="Input.PhoneNumber" class="form-control" oninput="formatoTelefono(this)" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-primary">Guardar</button>
        </form>
    </div>
 
</div>
</body>
<br />
<br />
<br />
<br />
<script>

    document.getElementById('correoInput').addEventListener('input', function () {
        var correoValue = this.value;
        document.getElementById('usernameInput').value = correoValue;
        document.getElementById('normalizedNameInput').value = correoValue.toUpperCase();
    });


    //La evaluacion de genero al cambiar
    function ValidacionGenero(fieldName, value) {
        document.getElementById(fieldName).value = value;
    }

    //muestra el genero actual y selecciona

    var generoActual = "@Model.Input.Genero";
    var selectGenero = document.getElementById("generoSeleccion");
    for (var i = 0; i < selectGenero.options.length; i++) {
        if (selectGenero.options[i].value === generoActual) {
            selectGenero.options[i].setAttribute("selected", "selected");
            break;
        }
    }

    //Formato la cedula

    function formatoCedula(input) {
        var cedulaSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
        if (cedulaSinFormato.length > 9) {
            cedulaSinFormato = cedulaSinFormato.substr(0, 9);
        }
        var cedulaFormateada = '';
        for (var i = 0; i < cedulaSinFormato.length; i++) {
            if (i === 1 || i === 5) {
                cedulaFormateada += '-';
            }
            cedulaFormateada += cedulaSinFormato[i];
        }
        input.value = cedulaFormateada;
    }

    //Mostrar, limitar, formato y el tipo en la tarjeta y tipo de tarjeta
    function formatoYMostrarTipoTarjeta(input) {
        var numeroSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');

        // Limitar a 16
        if (numeroSinFormato.length > 16) {
            numeroSinFormato = numeroSinFormato.substr(0, 16);
        }

        // Aplicar el formato
        var numeroFormateado = '';
        for (var i = 0; i < numeroSinFormato.length; i++) {
            if (i > 0 && i % 4 == 0) {
                numeroFormateado += '-';
            }
            numeroFormateado += numeroSinFormato[i];
        }
        input.value = numeroFormateado;

        //Saber el tipo
        var tipo;
        if (/^4/.test(numeroSinFormato)) {
            tipo = "Visa";
        } else if (/^5/.test(numeroSinFormato)) {
            tipo = "Mastercard";
        } else if (/^3[47]/.test(numeroSinFormato)) {
            tipo = "American Express";
        } else {
            tipo = "Desconocida";
        }

        document.getElementById("tipoTarjetaInput").value = tipo;
    }

    //Limpia la pantalla de los errores al momento que se escribe

    function limpiarErrores(input) {
        var spanError = input.nextElementSibling;
        if (spanError) {
            spanError.textContent = '';
        }
    }
    var inputs = document.querySelectorAll('input');
    inputs.forEach(function (input) {
        input.addEventListener('input', function () {
            limpiarErrores(input);
        });
    });


    //Limpia la pantalla del error del tipo de tarjeta al momento que se escribe en el numero tarjeta

    function limpiarErrorTipoTarjeta() {
        var spanError = document.querySelector('#tipoTarjetaInput + .text-danger');
        if (spanError) {
            spanError.textContent = '';
        }
    }
    var numeroTarjetaInput = document.getElementById('Input.NumeroTarjeta');
    if (numeroTarjetaInput) {
        numeroTarjetaInput.addEventListener('input', function () {
            limpiarErrorTipoTarjeta();
        });
    }


    //Limpia el genero del error

    function limpiarErroresGenero() {
        var spanError = document.getElementById('errorGenero');
        if (spanError) {
            spanError.textContent = '';
        }
    }


    //Formato al telefono

    function formatoTelefono(input) {
        var telefonoSinFormato = input.value.replace(/-/g, '').replace(/\s+/g, '');
        if (telefonoSinFormato.length > 8) {
            telefonoSinFormato = telefonoSinFormato.substr(0, 8);
        }
        var telefonoFormateado = '';
        for (var i = 0; i < telefonoSinFormato.length; i++) {
            if (i === 4) {
                telefonoFormateado += '-';
            }
            telefonoFormateado += telefonoSinFormato[i];
        }
        input.value = telefonoFormateado;
    }
</script>
