@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Datos Personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}
<body class="body-update">
<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>Permite desgarcar los datos del usuario o eliminar la cuenta</p>
        <p>
            <strong>Eliminar estos datos eliminará permanentemente su cuenta y no se podrá recuperar</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Descargar datos del usuario</button>
        </form>
        <br />
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Eliminar Cuenta</a>
        </p>
    </div>
</div>
</body>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
